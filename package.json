{
  "name": "prehistoric-domain",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "cross-env MAIN_SCENE=$npm_config_mainscene ASSET_PREFIX=$npm_config_assetprefix NODE_ENV=production webpack --config webpack.prod.config.js",
    "build:all": "cross-env node build-all.js ASSET_PREFIX=$npm_config_assetprefix",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "npm:audit": "npm audit",
    "npm:audit:fix": "npm audit fix --force",
    "start": "cross-env MAIN_SCENE='gallery' ASSET_PREFIX='' webpack serve --port 8080",
    "prepare": "husky install"
  },
  "dependencies": {
    "aframe": "^1.7.1",
    "aframe-curve-component": "^0.1.3",
    "aframe-extras": "^7.5.4",
    "aframe-fps-counter-component": "^1.0.1",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "super-hands": "^3.0.4"
  },
  "semistandard": {
    "globals": [
      "AFRAME",
      "THREE"
    ],
    "ignore": [
      "build/**"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^9.11.1",
    "aframe-super-hot-html-loader": "^2.1.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "globals": "^15.9.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^8.0.0",
    "jsdom": "^24.0.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6",
    "webpack-glsl-loader": "^1.0.1"
  },
  "engines": {
    "node": ">= 4.6.0",
    "npm": ">= 2.15.9"
  }
}
